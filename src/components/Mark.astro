---
// The DITTO HUB monogram: a "D" whose bowl is a watch dial and whose stem carries sneaker lace slots.
// variant "live"   – hands follow the time in India (set by the site script)
// variant "intro"  – parts animate in (see .intro styles)
// variant "spin"   – hands keep turning (404 page)
// variant "static" – hands fixed at 10:10
interface Props {
  variant?: 'live' | 'intro' | 'spin' | 'static';
  class?: string;
  label?: string;
}

const { variant = 'static', class: className, label, ...rest } = Astro.props;

const BODY =
  'M0,0H100A150,150 0 0 1 100,300H0ZM50,50V250H100A100,100 0 0 0 100,50ZM32.5,102.5H17.5A5.5,5.5 0 0 0 17.5,113.5H32.5A5.5,5.5 0 0 0 32.5,102.5ZM32.5,144.5H17.5A5.5,5.5 0 0 0 17.5,155.5H32.5A5.5,5.5 0 0 0 32.5,144.5ZM32.5,186.5H17.5A5.5,5.5 0 0 0 17.5,197.5H32.5A5.5,5.5 0 0 0 32.5,186.5Z';
const CROWN = 'M244,130H262A5,5 0 0 1 267,135V165A5,5 0 0 1 262,170H244Z';
const PIVOT = 'M115,150A10,10 0 1 0 135,150A10,10 0 1 0 115,150ZM121,150A4,4 0 1 1 129,150A4,4 0 1 1 121,150Z';
// Hour markers at 12, 3, 6 and 9 o'clock, written without transforms so they can animate.
const MARKERS = [
  { x: 121, y: 84, w: 8, h: 14 },
  { x: 177, y: 146, w: 14, h: 8 },
  { x: 121, y: 202, w: 8, h: 14 },
  { x: 59, y: 146, w: 14, h: 8 },
];
const live = variant === 'live';
const intro = variant === 'intro';
const spin = variant === 'spin';
const handClass = (kind: 'hour' | 'min') =>
  live ? `mk-hand mk-${kind}` : intro ? `im-${kind}` : spin ? `sp-hand sp-${kind}` : undefined;
const handTransform = (deg: number) => (live || intro || spin ? undefined : `rotate(${deg} 125 150)`);
---

<svg
  {...rest}
  class={className}
  viewBox="-14 -14 295 328"
  focusable="false"
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  data-mark={live ? 'live' : undefined}
>
  <g fill="url(#dh-gold)">
    <g class={intro ? 'im-body' : undefined}>
      <path d={BODY} fill-rule="evenodd"></path>
      <path d={CROWN}></path>
    </g>
    <g>
      {MARKERS.map((m) => <rect class={intro ? 'im-marker' : undefined} x={m.x} y={m.y} width={m.w} height={m.h} rx="4" />)}
    </g>
    <g class={handClass('hour')} transform={handTransform(-55)}>
      <rect x="119" y="110" width="12" height="49" rx="6"></rect>
    </g>
    <g class={handClass('min')} transform={handTransform(60)}>
      <rect x="121" y="88" width="8" height="73" rx="4"></rect>
    </g>
    <path d={PIVOT} fill-rule="evenodd"></path>
  </g>
</svg>
