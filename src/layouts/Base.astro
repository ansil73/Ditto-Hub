---
import '@fontsource/unbounded/latin-700.css';
import '@fontsource/unbounded/latin-800.css';
import '@fontsource/manrope/latin-500.css';
import '@fontsource/manrope/latin-600.css';
import '@fontsource/manrope/latin-700.css';
import '@fontsource/manrope/latin-800.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FloatingContact from '../components/FloatingContact.astro';
import Mark from '../components/Mark.astro';
import { settings, offers, combos, products, BUILD_NOW } from '../lib/catalog';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  jsonld?: Record<string, unknown>[];
  noindex?: boolean;
  intro?: boolean;
  bodyClass?: string;
}

const {
  title,
  description = 'DITTO HUB: sneakers, watches and new gadgets at budget prices, with All-India delivery. New arrivals and offers every day. Order on WhatsApp.',
  image = '/og.png',
  jsonld = [],
  noindex = false,
  intro = false,
  bodyClass,
} = Astro.props;

const site = Astro.site ?? new URL('https://ditto-hub.pages.dev');
const pageTitle = title ? `${title} | DITTO HUB` : 'DITTO HUB | Luxury looks. Budget prices.';
const canonical = new URL(Astro.url.pathname, site).href;
const ogImage = new URL(image, site).href;

const config = {
  whatsapp: settings.whatsapp,
  phone: settings.phone,
  instagram: settings.instagram,
  group: settings.whatsappGroup,
  announcement: settings.announcement,
  analytics: settings.analytics && !!settings.goatcounterCode,
  goatcounter: settings.goatcounterCode,
  preview: __PREVIEW__,
  arrivals: products.map((p) => p.arrivalDate),
};
const goldStops = [
  ['0', '#F6DE9E'],
  ['0.38', '#D9B061'],
  ['0.66', '#F0CF83'],
  ['1', '#A87A2C'],
];
---

<!doctype html>
<html lang="en" data-root="/" data-index="">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#0A0A0B" />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/icons/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="DITTO HUB" />
    <meta property="og:title" content={title ?? 'DITTO HUB'} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="en_IN" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title ?? 'DITTO HUB'} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    {jsonld.map((data) => <script type="application/ld+json" set:html={JSON.stringify(data)} />)}
    {
      intro && (
        <script is:inline>
          try {
            if (sessionStorage.getItem('dh-intro') || matchMedia('(prefers-reduced-motion: reduce)').matches) {
              document.documentElement.classList.add('intro-seen');
            }
          } catch (e) {}
        </script>
      )
    }
  </head>
  <body class={bodyClass}>
    <svg class="visually-hidden" width="0" height="0" aria-hidden="true" focusable="false">
      <defs>
        <linearGradient id="dh-gold" gradientUnits="userSpaceOnUse" x1="0" y1="0" x2="267" y2="300">
          {goldStops.map(([o, c]) => <stop offset={o} stop-color={c} />)}
        </linearGradient>
        <linearGradient id="dh-gold-word" gradientUnits="userSpaceOnUse" x1="0" y1="0" x2="731.5" y2="100">
          {goldStops.map(([o, c]) => <stop offset={o} stop-color={c} />)}
        </linearGradient>
      </defs>
    </svg>

    {
      intro && (
        <div class="intro" data-intro aria-hidden="true">
          <div class="intro-wrap">
            <Mark variant="intro" class="intro-mark" />
            <span class="intro-glint" />
          </div>
          <button class="intro-skip" type="button" tabindex="-1" data-intro-skip>
            Skip
          </button>
        </div>
      )
    }

    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <FloatingContact />
    <div class="toasts" role="status" aria-live="polite" data-toasts></div>

    <script type="application/json" id="dh-config" set:html={JSON.stringify(config)} />
    <script type="application/json" id="dh-offers" set:html={JSON.stringify({ builtAt: BUILD_NOW, offers, combos })} />
    <script>
      import '../scripts/site';
    </script>
  </body>
</html>
